# Copy these keys into Streamlit Community Cloud > App > Settings > Secrets.
# Locally, copy this file to .streamlit/secrets.toml and replace every example value.
# Do not commit the real secrets.toml.

APP_ACCESS_PASSWORD = "replace-with-a-long-random-dashboard-password"

OWNER_EMAIL = "owner@example.com"
OWNER_PASSWORD = "replace-with-owner-account-password"

CHILD_EMAIL = "child@example.com"
CHILD_PASSWORD = "replace-with-child-account-password"
